# ---- Calthem Bolna engine keys ----
# Fill these with your own provider keys, then rename to .env
# (These stay on your machine; never commit real keys.)

# LLM brain (also used for extraction schema generation)
OPENAI_API_KEY=
EXTRACTION_PROMPT_GENERATION_MODEL=gpt-4o-mini
CHECK_FOR_COMPLETION_LLM=gpt-4o-mini

# Speech-to-text (hearing)
DEEPGRAM_AUTH_TOKEN=

# Text-to-speech (voice)
ELEVENLABS_API_KEY=

# Engine port
BOLNA_PORT=5001
